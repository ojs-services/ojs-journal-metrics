# ---------------------------------------------------------------- General

msgid "plugins.generic.journalMetrics.displayName"
msgstr "Métricas de la revista"

msgid "plugins.generic.journalMetrics.description"
msgstr "Un conjunto completo de métricas de la revista: estadísticas editoriales, tiempos de respuesta, uso, comunidad y volumen de publicación, con una caché de instantáneas nocturna, control de visibilidad por métrica, indicadores externos, un panel de administración, una página pública, un bloque para la barra lateral y una función de plantilla {journal_metric}."

