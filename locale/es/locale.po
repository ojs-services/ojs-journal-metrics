# ---------------------------------------------------------------- Tooltips (methodology)

msgid "plugins.generic.journalMetrics.tooltip.acceptanceRate"
msgstr "Envíos aceptados divididos entre todos los envíos con decisión (aceptados + rechazados). Solo cuentan los envíos con una decisión editorial; no cuentan los artículos añadidos directamente a los números ni los envíos que siguen en revisión."

msgid "plugins.generic.journalMetrics.tooltip.declineRate"
msgstr "Envíos rechazados (antes de la revisión + después de la revisión) divididos entre todos los envíos con decisión (aceptados + rechazados). Solo cuentan los envíos con una decisión editorial; no cuentan los artículos añadidos directamente a los números ni los envíos que siguen en revisión."

msgid "plugins.generic.journalMetrics.tooltip.firstDecisionDays"
msgstr "Promedio de días desde el envío hasta la primera decisión editorial de cualquier tipo. Solo se miden los envíos con una decisión editorial y fechas coherentes."

msgid "plugins.generic.journalMetrics.tooltip.submissionToAcceptDays"
msgstr "Promedio de días desde el envío hasta la primera decisión de aceptación. También se muestran la mediana y el percentil 80 (el valor por debajo del cual queda el 80 % de los artículos); n es el número de artículos medidos."

msgid "plugins.generic.journalMetrics.tooltip.submissionToRejectDays"
msgstr "Promedio de días desde el envío hasta la primera decisión de rechazo, calculado solo sobre los envíos rechazados."

msgid "plugins.generic.journalMetrics.tooltip.reviewReportDays"
msgstr "Promedio de días entre la invitación a revisar y el informe de revisión completado. Se excluyen las asignaciones de revisión rechazadas y canceladas."

msgid "plugins.generic.journalMetrics.tooltip.acceptToPublishDays"
msgstr "Promedio de días desde la decisión de aceptación hasta la primera fecha de publicación del artículo."

msgid "plugins.generic.journalMetrics.tooltip.submissionToPublishDays"
msgstr "Promedio de días desde el envío hasta la primera fecha de publicación del artículo (tiempo total editorial y de producción)."

