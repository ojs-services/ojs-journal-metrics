# ---------------------------------------------------------------- Tooltips (methodology)

msgid "plugins.generic.journalMetrics.tooltip.acceptanceRate"
msgstr "Accepted submissions divided by submissions received, computed by the OJS core statistics engine. Within a date range, only submissions received in that range that have reached a final decision are counted."

msgid "plugins.generic.journalMetrics.tooltip.declineRate"
msgstr "Declined submissions (desk + post-review) divided by submissions received, computed by the OJS core statistics engine. Within a date range, only submissions received in that range that have reached a final decision are counted."

msgid "plugins.generic.journalMetrics.tooltip.firstDecisionDays"
msgstr "Average days from submission to the first editorial decision of any kind. Incomplete and imported submissions are excluded."

msgid "plugins.generic.journalMetrics.tooltip.submissionToAcceptDays"
msgstr "Average days from submission to the first acceptance decision. Median and the 80th percentile (the value 80% of articles stay under) are shown alongside; n is the number of articles measured."

msgid "plugins.generic.journalMetrics.tooltip.submissionToRejectDays"
msgstr "Average days from submission to the first rejection decision, over declined submissions only."

msgid "plugins.generic.journalMetrics.tooltip.reviewReportDays"
msgstr "Average days between the review invitation and the completed review report. Declined and cancelled review assignments are excluded."

msgid "plugins.generic.journalMetrics.tooltip.acceptToPublishDays"
msgstr "Average days from the acceptance decision to the article's first publication date."

msgid "plugins.generic.journalMetrics.tooltip.submissionToPublishDays"
msgstr "Average days from submission to the article's first publication date (total editorial + production time)."

