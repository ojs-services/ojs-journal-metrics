# ---------------------------------------------------------------- Tooltips (methodology)

msgid "plugins.generic.journalMetrics.tooltip.acceptanceRate"
msgstr "Submissões aceitas divididas pelo total de submissões com decisão (aceitas + recusadas). Contam somente as submissões com decisão editorial; artigos incluídos diretamente nas edições e submissões ainda em avaliação não contam."

msgid "plugins.generic.journalMetrics.tooltip.declineRate"
msgstr "Submissões recusadas (na entrada + após avaliação) divididas pelo total de submissões com decisão (aceitas + recusadas). Contam somente as submissões com decisão editorial; artigos incluídos diretamente nas edições e submissões ainda em avaliação não contam."

msgid "plugins.generic.journalMetrics.tooltip.firstDecisionDays"
msgstr "Média de dias entre a submissão e a primeira decisão editorial, de qualquer tipo. São medidas somente as submissões com decisão editorial e datas consistentes."

msgid "plugins.generic.journalMetrics.tooltip.submissionToAcceptDays"
msgstr "Média de dias entre a submissão e a primeira decisão de aceitação. A mediana e o percentil 80 (o valor abaixo do qual ficam 80% dos artigos) são exibidos ao lado; n é o número de artigos medidos."

msgid "plugins.generic.journalMetrics.tooltip.submissionToRejectDays"
msgstr "Média de dias entre a submissão e a primeira decisão de rejeição, considerando somente as submissões recusadas."

msgid "plugins.generic.journalMetrics.tooltip.reviewReportDays"
msgstr "Média de dias entre o convite para avaliação e a entrega do parecer concluído. Designações de avaliação recusadas e canceladas são excluídas."

msgid "plugins.generic.journalMetrics.tooltip.acceptToPublishDays"
msgstr "Média de dias entre a decisão de aceitação e a primeira data de publicação do artigo."

msgid "plugins.generic.journalMetrics.tooltip.submissionToPublishDays"
msgstr "Média de dias entre a submissão e a primeira data de publicação do artigo (tempo total editorial + produção)."

