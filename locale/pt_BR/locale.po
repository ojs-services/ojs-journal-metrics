msgstr "Publicações"

msgid "plugins.generic.journalMetrics.section.editorial"
msgstr "Processo editorial"

msgid "plugins.generic.journalMetrics.section.external"
msgstr "Indicadores externos"

msgid "plugins.generic.journalMetrics.section.editorial.note"
msgstr "Os números do processo editorial se baseiam em {$process} submissões recebidas pelo sistema da revista que receberam uma decisão editorial. {$direct} artigos incluídos diretamente nas edições entram nos números de publicação, e não nestas taxas e tempos."

msgid "plugins.generic.journalMetrics.group.review"
msgstr "Avaliação por pares"

msgid "plugins.generic.journalMetrics.settings.manual.rejected"
msgstr "Não salvo: \"{$titles}\". Este nome pertence a um número calculado a partir dos dados da revista, por isso não pode ser informado manualmente."

msgid "plugins.generic.journalMetrics.ui.manualConflict"
msgstr "Não exibido na página pública: um número com este nome é calculado a partir dos dados da revista. Altere o nome ou exclua a linha."

msgid "plugins.generic.journalMetrics.ui.enteredByEditor"
msgstr "Informado pelo editor"

msgid "plugins.generic.journalMetrics.ui.splitTitle"
msgstr "Artigos por ano: pelo processo editorial / incluídos diretamente"

msgid "plugins.generic.journalMetrics.ui.processArticles"
msgstr "Pelo processo editorial"

msgid "plugins.generic.journalMetrics.ui.directArticles"
msgstr "Incluídos diretamente"

msgid "plugins.generic.journalMetrics.ui.editorialHiddenAuto"
msgstr "Ainda não exibido na página pública: menos de 20 submissões têm uma decisão editorial final."

msgid "plugins.generic.journalMetrics.ui.editorialHiddenSetting"
msgstr "Oculto na página pública (configuração)."

msgid "plugins.generic.journalMetrics.editorBox.title"
msgstr "Por que os números desta página são diferentes?"

msgid "plugins.generic.journalMetrics.editorBox.published"
msgstr "Sua revista tem {$published} artigos publicados."

msgid "plugins.generic.journalMetrics.editorBox.process"
msgstr "{$count} deles foram submetidos pelo sistema da revista e receberam uma decisão editorial. As taxas de aceitação e os tempos são calculados a partir de submissões como essas."

msgid "plugins.generic.journalMetrics.editorBox.direct"
msgstr "{$count} artigos foram incluídos diretamente nas edições, sem decisão editorial. Eles contam nos números de publicação; sem decisão e sem datas próprias, não podem contar nas taxas e nos tempos."

msgid "plugins.generic.journalMetrics.editorBox.inconsistent"
msgstr "{$count} artigos ficaram de fora dos tempos porque as datas deles não são coerentes entre si (submetidos após a publicação)."

msgid "plugins.generic.journalMetrics.editorBox.awaiting"
msgstr "{$count} submissões ainda aguardam uma primeira decisão; elas serão contabilizadas quando houver decisão."

msgid "plugins.generic.journalMetrics.editorBox.hiddenAuto"
msgstr "A seção \"Processo editorial\" ainda não é exibida na página pública: {$count} submissões têm decisão final; ela aparece a partir de {$min}."

msgid "plugins.generic.journalMetrics.editorBox.hiddenSetting"
msgstr "A seção \"Processo editorial\" está oculta na página pública (configuração)."

msgid "plugins.generic.journalMetrics.editorBox.list"
msgstr "Lista"

msgid "plugins.generic.journalMetrics.editorBox.actions"
msgstr "O que você pode fazer:"

msgid "plugins.generic.journalMetrics.editorBox.actionSection"
msgstr "exibir ou ocultar a seção editorial"

msgid "plugins.generic.journalMetrics.editorBox.actionStartYear"
msgstr "informar um ano de início"

msgid "plugins.generic.journalMetrics.settings.editorialSection"
msgstr "Seção \"Processo editorial\" na página pública"

msgid "plugins.generic.journalMetrics.settings.editorialSection.auto"
msgstr "Automático (recomendado)"

msgid "plugins.generic.journalMetrics.settings.editorialSection.show"
msgstr "Sempre exibir"

msgid "plugins.generic.journalMetrics.settings.editorialSection.hide"
msgstr "Ocultar"

msgid "plugins.generic.journalMetrics.settings.editorialSection.desc"
msgstr "O modo automático exibe a seção quando 20 submissões tiverem uma decisão editorial final, com uma breve observação quando houver artigos incluídos sem decisão."

msgid "plugins.generic.journalMetrics.settings.advanced"
msgstr "Avançado"

msgid "plugins.generic.journalMetrics.settings.advanced.desc"
msgstr "Não é necessário para que os números estejam corretos; altere somente se a sua revista precisar."

msgid "plugins.generic.journalMetrics.settings.excludedSections"
msgstr "Excluir estas seções das contagens de publicação"

msgid "plugins.generic.journalMetrics.settings.excludedSections.desc"
msgstr "Por exemplo, Editorial ou Errata. Aplica-se a artigos publicados, autores e países; o processo editorial não é afetado."

msgid "plugins.generic.journalMetrics.settings.yearBreakdown"
msgstr "Dividir o gráfico de artigos por ano: pelo processo editorial / incluídos diretamente"

msgid "plugins.generic.journalMetrics.settings.yearBreakdown.desc"
msgstr "Adiciona uma pequena tabela abaixo do gráfico."

msgid "plugins.generic.journalMetrics.articles.directTitle"
msgstr "Artigos incluídos sem decisão editorial"

msgid "plugins.generic.journalMetrics.articles.directDesc"
msgstr "Eles contam nos números de publicação, e não nas taxas e nos tempos."

msgid "plugins.generic.journalMetrics.articles.inconsistentTitle"
msgstr "Artigos deixados de fora dos tempos"

msgid "plugins.generic.journalMetrics.articles.inconsistentDesc"
msgstr "A data de submissão é posterior à data de publicação, por isso não é possível calcular nenhum tempo."

msgid "plugins.generic.journalMetrics.articles.none"
msgstr "Não há artigos nessa situação."

msgid "plugins.generic.journalMetrics.articles.byYear"
msgstr "Por ano"

msgid "plugins.generic.journalMetrics.articles.list"
msgstr "Artigos"

msgid "plugins.generic.journalMetrics.articles.titleCol"
msgstr "Título"

msgid "plugins.generic.journalMetrics.articles.publishedCol"
msgstr "Publicado"

msgid "plugins.generic.journalMetrics.articles.submittedCol"
msgstr "Submetido"

msgid "plugins.generic.journalMetrics.articles.truncated"
msgstr "Somente os {$limit} mais recentes estão listados."

msgid "plugins.generic.journalMetrics.settings.nightlyStale"
msgstr "O cálculo noturno não é executado há {$days} dias; os números são de {$date}. O plugin tenta corrigir isso automaticamente. Se este aviso continuar aqui amanhã, avise o administrador do site."

msgid "plugins.generic.journalMetrics.settings.nightlyNever"
msgstr "O cálculo noturno ainda não foi executado. O plugin tenta corrigir isso automaticamente. Se este aviso continuar aqui amanhã, avise o administrador do site."
