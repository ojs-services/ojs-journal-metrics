msgstr "Supressão de amostras pequenas (n)"

msgid "plugins.generic.journalMetrics.settings.rateNThreshold.desc"
msgstr "Métricas de taxa e de tempo calculadas a partir de menos registros do que este valor são suprimidas nas páginas públicas e esmaecidas no painel de controle (padrão: 10)."

msgid "plugins.generic.journalMetrics.settings.includeUnknown"
msgstr "Incluir registros sem país"

msgid "plugins.generic.journalMetrics.settings.showAuthorsTab"
