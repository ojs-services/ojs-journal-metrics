msgstr "Publicações"

msgid "plugins.generic.journalMetrics.section.editorial"
msgstr "Processo editorial"

msgid "plugins.generic.journalMetrics.section.external"
msgstr "Indicadores externos"

msgid "plugins.generic.journalMetrics.section.editorial.note"
msgstr "Os números do processo editorial baseiam-se em {$process} submissões recebidas através do sistema da revista que obtiveram uma decisão editorial. Os {$direct} artigos adicionados diretamente às edições estão incluídos nos números de publicação, mas não nestas taxas e tempos."

msgid "plugins.generic.journalMetrics.group.review"
msgstr "Revisão por pares"

msgid "plugins.generic.journalMetrics.settings.manual.rejected"
msgstr "Não guardado: «{$titles}». Este nome pertence a um valor calculado a partir dos dados da revista, pelo que não pode ser introduzido manualmente."

msgid "plugins.generic.journalMetrics.ui.manualConflict"
msgstr "Não apresentado na página pública: existe um valor com este nome que é calculado a partir dos dados da revista. Altere o nome ou elimine a linha."

msgid "plugins.generic.journalMetrics.ui.enteredByEditor"
msgstr "Introduzido pelo editor"

msgid "plugins.generic.journalMetrics.ui.splitTitle"
msgstr "Artigos por ano: pelo processo editorial / adicionados diretamente"

msgid "plugins.generic.journalMetrics.ui.processArticles"
msgstr "Pelo processo editorial"

msgid "plugins.generic.journalMetrics.ui.directArticles"
msgstr "Adicionados diretamente"

msgid "plugins.generic.journalMetrics.ui.editorialHiddenAuto"
msgstr "Ainda não apresentado na página pública: menos de 20 submissões têm uma decisão editorial final."

msgid "plugins.generic.journalMetrics.ui.editorialHiddenSetting"
