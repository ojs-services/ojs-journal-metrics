msgid "plugins.generic.journalMetrics.editorBox.title"
msgstr "Porque é que os números desta página diferem?"

msgid "plugins.generic.journalMetrics.editorBox.published"
msgstr "A sua revista tem {$published} artigos publicados."

msgid "plugins.generic.journalMetrics.editorBox.process"
msgstr "{$count} deles foram submetidos através do sistema da revista e obtiveram uma decisão editorial. As taxas de aceitação e os tempos são calculados a partir de submissões como estas."

msgid "plugins.generic.journalMetrics.editorBox.direct"
msgstr "{$count} artigos foram adicionados diretamente às edições sem decisão editorial. Contam nos números de publicação; sem decisão e sem datas próprias, não podem contar nas taxas nem nos tempos."

msgid "plugins.generic.journalMetrics.editorBox.inconsistent"
msgstr "{$count} artigos foram excluídos dos tempos porque as respetivas datas não são coerentes (submetidos após a publicação)."

msgid "plugins.generic.journalMetrics.editorBox.awaiting"
msgstr "{$count} submissões aguardam ainda uma primeira decisão; serão contabilizadas quando forem decididas."

msgid "plugins.generic.journalMetrics.editorBox.hiddenAuto"
msgstr "A secção «Processo editorial» ainda não é apresentada na página pública: {$count} submissões têm decisão final; a secção aparece a partir de {$min}."

msgid "plugins.generic.journalMetrics.editorBox.hiddenSetting"
msgstr "A secção «Processo editorial» está oculta na página pública (configuração)."

msgid "plugins.generic.journalMetrics.editorBox.list"
msgstr "Lista"

msgid "plugins.generic.journalMetrics.editorBox.actions"
msgstr "O que pode fazer:"

msgid "plugins.generic.journalMetrics.editorBox.actionSection"
msgstr "mostrar ou ocultar a secção editorial"

msgid "plugins.generic.journalMetrics.editorBox.actionStartYear"
msgstr "indicar um ano de início"

msgid "plugins.generic.journalMetrics.settings.editorialSection"
msgstr "Secção «Processo editorial» na página pública"

msgid "plugins.generic.journalMetrics.settings.editorialSection.auto"
msgstr "Automático (recomendado)"

msgid "plugins.generic.journalMetrics.settings.editorialSection.show"
msgstr "Mostrar sempre"

msgid "plugins.generic.journalMetrics.settings.editorialSection.hide"
msgstr "Ocultar"

msgid "plugins.generic.journalMetrics.settings.editorialSection.desc"
msgstr "A opção Automático mostra a secção quando 20 submissões tiverem uma decisão editorial final, com uma breve nota quando houver artigos adicionados sem decisão."

msgid "plugins.generic.journalMetrics.settings.advanced"
msgstr "Avançado"

msgid "plugins.generic.journalMetrics.settings.advanced.desc"
msgstr "Não é necessário para obter números corretos; altere apenas se a sua revista precisar."

msgid "plugins.generic.journalMetrics.settings.excludedSections"
msgstr "Excluir estas secções das contagens de publicação"

msgid "plugins.generic.journalMetrics.settings.excludedSections.desc"
msgstr "Por exemplo, Editorial ou Errata. Aplica-se aos artigos publicados, autores e países; o processo editorial não é afetado."

msgid "plugins.generic.journalMetrics.settings.yearBreakdown"
msgstr "Dividir o gráfico de artigos por ano: pelo processo editorial / adicionados diretamente"

msgid "plugins.generic.journalMetrics.settings.yearBreakdown.desc"
msgstr "Acrescenta uma pequena tabela por baixo do gráfico."

msgid "plugins.generic.journalMetrics.articles.directTitle"
msgstr "Artigos adicionados sem decisão editorial"

msgid "plugins.generic.journalMetrics.articles.directDesc"
msgstr "Contam nos números de publicação, mas não nas taxas nem nos tempos."

msgid "plugins.generic.journalMetrics.articles.inconsistentTitle"
msgstr "Artigos excluídos dos tempos"

msgid "plugins.generic.journalMetrics.articles.inconsistentDesc"
msgstr "A data de submissão é posterior à data de publicação, pelo que não é possível calcular nenhum tempo."

msgid "plugins.generic.journalMetrics.articles.none"
msgstr "Não existem artigos nestas condições."

msgid "plugins.generic.journalMetrics.articles.byYear"
msgstr "Por ano"

msgid "plugins.generic.journalMetrics.articles.list"
msgstr "Artigos"

msgid "plugins.generic.journalMetrics.articles.titleCol"
msgstr "Título"

msgid "plugins.generic.journalMetrics.articles.publishedCol"
msgstr "Publicado"

msgid "plugins.generic.journalMetrics.articles.submittedCol"
msgstr "Submetido"

msgid "plugins.generic.journalMetrics.articles.truncated"
msgstr "Apenas são listados os {$limit} mais recentes."

msgid "plugins.generic.journalMetrics.settings.nightlyStale"
msgstr "O cálculo noturno não é executado há {$days} dias; os números são de {$date}. O plugin tenta resolver isto automaticamente. Se este aviso ainda aqui estiver amanhã, informe o administrador do portal."

msgid "plugins.generic.journalMetrics.settings.nightlyNever"
msgstr "O cálculo noturno ainda não foi executado. O plugin tenta resolver isto automaticamente. Se este aviso ainda aqui estiver amanhã, informe o administrador do portal."
