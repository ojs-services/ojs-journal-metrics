# ---------------------------------------------------------------- Tooltips (methodology)

msgid "plugins.generic.journalMetrics.tooltip.acceptanceRate"
msgstr "Submissões aceites divididas pelo total de submissões com decisão (aceites + recusadas). Só contam as submissões com decisão editorial; não contam os artigos adicionados diretamente às edições nem as submissões ainda em revisão."

msgid "plugins.generic.journalMetrics.tooltip.declineRate"
msgstr "Submissões recusadas (pelo secretariado + após revisão) divididas pelo total de submissões com decisão (aceites + recusadas). Só contam as submissões com decisão editorial; não contam os artigos adicionados diretamente às edições nem as submissões ainda em revisão."

msgid "plugins.generic.journalMetrics.tooltip.firstDecisionDays"
msgstr "Média de dias desde a submissão até à primeira decisão editorial, seja de que tipo for. Só são medidas as submissões com decisão editorial e datas coerentes."

msgid "plugins.generic.journalMetrics.tooltip.submissionToAcceptDays"
msgstr "Média de dias desde a submissão até à primeira decisão de aceitação. São também apresentados a mediana e o percentil 80 (o valor abaixo do qual ficam 80% dos artigos); n é o número de artigos medidos."

msgid "plugins.generic.journalMetrics.tooltip.submissionToRejectDays"
msgstr "Média de dias desde a submissão até à primeira decisão de rejeição, considerando apenas as submissões recusadas."

msgid "plugins.generic.journalMetrics.tooltip.reviewReportDays"
msgstr "Média de dias entre o convite para revisão e a entrega do relatório de revisão. As atribuições de revisão recusadas e canceladas são excluídas."

msgid "plugins.generic.journalMetrics.tooltip.acceptToPublishDays"
msgstr "Média de dias desde a decisão de aceitação até à primeira data de publicação do artigo."

msgid "plugins.generic.journalMetrics.tooltip.submissionToPublishDays"
msgstr "Média de dias desde a submissão até à primeira data de publicação do artigo (tempo total editorial + de produção)."

