msgstr "Os países com menos autores/artigos do que este valor são ocultados nas tabelas de países."

msgid "plugins.generic.journalMetrics.settings.rateNThreshold"
msgstr "Supressão de amostras pequenas (n)"

msgid "plugins.generic.journalMetrics.settings.rateNThreshold.desc"
msgstr "As métricas de taxas e de tempos calculadas a partir de menos registos do que este valor são suprimidas nas páginas públicas e atenuadas no painel (por omissão: 10)."

msgid "plugins.generic.journalMetrics.settings.includeUnknown"
