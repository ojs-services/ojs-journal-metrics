# ---------------------------------------------------------------- General

msgid "plugins.generic.journalMetrics.displayName"
msgstr "Métricas da revista"

msgid "plugins.generic.journalMetrics.description"
msgstr "Um conjunto completo de métricas da revista: estatísticas editoriais, tempos de processamento, utilização, comunidade e volume de publicação — com um instantâneo noturno em cache, controlo da visibilidade de cada métrica, métricas manuais (declaradas pelo editor), um painel de administração, uma página pública, um bloco da barra lateral e uma função de modelo {journal_metric}."

