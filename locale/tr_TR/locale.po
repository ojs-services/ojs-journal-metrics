# ---------------------------------------------------------------- Metodoloji ipuçları

msgid "plugins.generic.journalMetrics.tooltip.acceptanceRate"
msgstr "Kabul edilen gönderilerin alınan gönderilere oranıdır; OJS çekirdek istatistik motoruyla hesaplanır. Tarih aralığında yalnızca o aralıkta gönderilmiş VE nihai karar almış gönderiler sayılır."

msgid "plugins.generic.journalMetrics.tooltip.declineRate"
msgstr "Reddedilen gönderilerin (masa + hakem sonrası) alınan gönderilere oranıdır; OJS çekirdek istatistik motoruyla hesaplanır. Tarih aralığında yalnızca o aralıkta gönderilmiş VE nihai karar almış gönderiler sayılır."

msgid "plugins.generic.journalMetrics.tooltip.firstDecisionDays"
msgstr "Gönderiden herhangi bir ilk editoryal karara kadar geçen ortalama gün. Tamamlanmamış ve içe aktarılmış gönderiler hariçtir."

msgid "plugins.generic.journalMetrics.tooltip.submissionToAcceptDays"
msgstr "Gönderiden ilk kabul kararına kadar geçen ortalama gün. Yanında medyan ve %80 dilimi (makalelerin %80'inin altında kaldığı değer) gösterilir; n ölçülen makale sayısıdır."

msgid "plugins.generic.journalMetrics.tooltip.submissionToRejectDays"
msgstr "Yalnızca reddedilen gönderiler üzerinden, gönderiden ilk ret kararına kadar geçen ortalama gün."

msgid "plugins.generic.journalMetrics.tooltip.reviewReportDays"
msgstr "Hakem davetinden tamamlanan rapora kadar geçen ortalama gün. Reddedilen ve iptal edilen hakemlik atamaları hariçtir."

msgid "plugins.generic.journalMetrics.tooltip.acceptToPublishDays"
msgstr "Kabul kararından makalenin ilk yayın tarihine kadar geçen ortalama gün."

msgid "plugins.generic.journalMetrics.tooltip.submissionToPublishDays"
msgstr "Gönderiden makalenin ilk yayın tarihine kadar geçen ortalama gün (toplam editoryal + üretim süresi)."

