msgstr "Kenar çubuğu bloğu: şu an etkin"

msgid "plugins.generic.journalMetrics.settings.block.statusPassive"
msgstr "Kenar çubuğu bloğu: kenar çubuğuna ekli değil (pasif)"

msgid "plugins.generic.journalMetrics.settings.block.manage"
